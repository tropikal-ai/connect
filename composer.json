{
    "name": "tropikal-ai/connect",
    "description": "Framework-agnostic TROPIKAL Connect protocol and public-channel application core.",
    "keywords": [
        "oauth",
        "pkce",
        "signed-requests",
        "resources",
        "chat",
        "booking"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tropikal AI"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "TropikalAI\\Connect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TropikalAI\\Connect\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "pint",
        "test": "phpunit --colors=never"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
